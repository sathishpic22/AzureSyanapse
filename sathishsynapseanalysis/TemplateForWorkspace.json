		{
			"name": "[concat(parameters('workspaceName'), '/brones_to_silverdata')]",
			"type": "Microsoft.Synapse/workspaces/notebooks",
			"apiVersion": "2019-06-01-preview",
			"properties": {
				"nbformat": 4,
				"nbformat_minor": 2,
				"bigDataPool": {
					"referenceName": "mysprakpool",
					"type": "BigDataPoolReference"
				},
				"sessionProperties": {
					"driverMemory": "28g",
					"driverCores": 4,
					"executorMemory": "28g",
					"executorCores": 4,
					"numExecutors": 2,
					"conf": {
						"spark.dynamicAllocation.enabled": "false",
						"spark.dynamicAllocation.minExecutors": "2",
						"spark.dynamicAllocation.maxExecutors": "2",
						"spark.autotune.trackingId": "9ed6c121-ba2d-4a2c-a925-146132374de4"
					}
				},
				"metadata": {
					"saveOutput": true,
					"enableDebugMode": false,
					"kernelspec": {
						"name": "synapse_pyspark",
						"display_name": "Synapse PySpark"
					},
					"language_info": {
						"name": "python"
					},
					"a365ComputeOptions": {
						"id": "/subscriptions/8cdbd8d3-556d-4296-a392-0c5585859716/resourceGroups/myetlpipelines/providers/Microsoft.Synapse/workspaces/sathishsynapseanalysis/bigDataPools/mysprakpool",
						"name": "mysprakpool",
						"type": "Spark",
						"endpoint": "https://sathishsynapseanalysis.dev.azuresynapse.net/livyApi/versions/2019-11-01-preview/sparkPools/mysprakpool",
						"auth": {
							"type": "AAD",
							"authResource": "https://dev.azuresynapse.net"
						},
						"sparkVersion": "3.5",
						"nodeCount": 3,
						"cores": 4,
						"memory": 28,
						"automaticScaleJobs": false
					},
					"sessionKeepAliveTimeout": 30
				},
				"cells": [
					{
						"cell_type": "code",
						"metadata": {
							"collapsed": false
						},
						"source": [
							"# Azure Synapse Spark Notebook (PySpark) - Silver Layer\n",
							"from pyspark.sql.functions import col, when, round\n",
							"\n",
							"# 1. Read Bronze Layer raw files\n",
							"df = spark.read.format(\"csv\") \\\n",
							"    .option(\"header\", \"true\") \\\n",
							"    .option(\"inferSchema\", \"true\") \\\n",
							"    .load(\"abfss://silver@myetlpipeline.dfs.core.windows.net/energy_mix_yearly_bronze_rawdata.csv\")\n",
							"\n",
							"# 2. Deduplicate and enforce schema\n",
							"df_silver = df.dropDuplicates([\"country\", \"year\"]) \\\n",
							"    .withColumn(\"year\", col(\"year\").cast(\"integer\")) \\\n",
							"    .withColumn(\"country\", col(\"country\").cast(\"string\")) \\\n",
							"    .withColumn(\"iso3\", col(\"iso3\").cast(\"string\")) \\\n",
							"    .withColumn(\"region\", col(\"region\").cast(\"string\"))\n",
							"\n",
							"# 3. Clip percentage values & compute derived metrics\n",
							"pct_cols = [\"coal_pct\", \"oil_pct\", \"gas_pct\", \"nuclear_pct\", \"hydro_pct\", \"solar_pct\"]\n",
							"for c in pct_cols:\n",
							"    df_silver = df_silver.withColumn(c, when(col(c) < 0, 0.0).when(col(c) > 100, 100.0).otherwise(col(c).cast(\"double\")))\n",
							"\n",
							"df_silver = df_silver \\\n",
							"    .withColumn(\"fossil_pct\", round(col(\"coal_pct\") + col(\"oil_pct\") + col(\"gas_pct\"), 2)) \\\n",
							"    .withColumn(\"clean_pct\", round(col(\"nuclear_pct\") + col(\"hydro_pct\") + col(\"solar_pct\"), 2))\n",
							"\n",
							"# 4. Write to Silver Delta Lake Table\n",
							"df_silver.write.format(\"delta\").mode(\"overwrite\").option(\"overwriteSchema\", \"true\") \\\n",
							"    .save(\"abfss://silver@myetlpipeline.dfs.core.windows.net/energy_mix_cleaned/\")"
						],
						"outputs": [],
						"execution_count": 9
					}
				]
			},
			"dependsOn": []
		},
